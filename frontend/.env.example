# Public build-time configuration ONLY. Never put secrets in VITE_* variables:
# everything here is embedded in the JavaScript bundle and visible to anyone.

# Leave empty when the API is served from the same origin (recommended:
# reverse-proxy /api to the backend). Otherwise e.g. https://api.achiever.ng
VITE_API_URL=
VITE_SUPPORT_EMAIL=support@example.com
