# Public build-time configuration ONLY. Never put secrets in VITE_* variables:
# everything here is embedded in the JavaScript bundle and visible to anyone.
# (Supabase, Paystack, Resend, Termii and LiveKit keys all live on the backend.)

# Where the browser sends API calls.
#  - Leave EMPTY (recommended): calls go to /api on this site. Locally the Vite
#    proxy forwards them to the backend; on Vercel, vercel.json forwards them to
#    Render. Sign-in cookies stay first-party and work in every browser.
#  - Or the API's own URL (e.g. https://api.achiever.ng when it shares the site's
#    domain). A different site such as *.onrender.com also works, but Safari and
#    Firefox may block its cookies. Must match API_PUBLIC_URL on the backend.
VITE_API_URL=

# Public address of this site (used for canonical links and share images on the
# public pages). Example: https://achiever.vercel.app
VITE_PUBLIC_SITE_URL=

# Shown on the public pages and in the app
VITE_SUPPORT_EMAIL=support@example.com
