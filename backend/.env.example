# ---------------------------------------------------------------------
# ACHIEVER backend configuration. Copy to .env and fill in.
# NEVER commit real values. NONE of these may be exposed to the React app.
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Public URLs (no trailing slash)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4100
# Extra allowed CORS origins, comma separated (optional)
CORS_EXTRA_ORIGINS=

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secrets used by the API itself (generate with: openssl rand -hex 32)
# JWT_SECRET  - keys HMACs for OTP codes and invite tokens
# SESSION_SECRET - signs CSRF tokens and the session-start cookie
# IDENTITY_HASH_SECRET - keys the one-way hash of BVN/NIN numbers (never rotate casually)
JWT_SECRET=
SESSION_SECRET=
IDENTITY_HASH_SECRET=
# Absolute session lifetime before a fresh login is required
SESSION_MAX_AGE_HOURS=168

# Paystack (Dashboard -> Settings -> API Keys & Webhooks)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Comma separated channels offered at checkout (must be enabled on your account)
PAYSTACK_CHANNELS=card,bank,ussd,bank_transfer
# Set true only after Transfers are enabled on your Paystack business account
PAYSTACK_TRANSFERS_ENABLED=false

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=ACHIEVER <no-reply@example.com>
SUPPORT_EMAIL=support@example.com

# Termii (SMS)
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com
# generic | dnd  (use dnd for OTP / transactional delivery to DND numbers)
TERMII_CHANNEL=dnd

# LiveKit (voice / video)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Bill payments provider: disabled | vtpass
BILL_PROVIDER=disabled
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Identity verification provider: manual (staff review of uploaded document)
# To use an automated BVN/NIN provider, implement an adapter in
# src/integrations/identity/ and select it here. See docs/INTEGRATIONS.md.
IDENTITY_PROVIDER=manual

# Background jobs (run in exactly one process per deployment, or rely on job locks)
ENABLE_JOBS=true
ENABLE_REALTIME_BRIDGE=true
